{
  "buildCommand": "bash scripts/build-vercel.sh",
  "outputDirectory": "artifacts/meridian/dist/public",
  "rewrites": [
    { "source": "/aldric-dashboard", "destination": "/aldric-dashboard/index.html" },
    { "source": "/aldric-dashboard/", "destination": "/aldric-dashboard/index.html" },
    { "source": "/aldric-dashboard/(?!assets/|favicon\\.svg|robots\\.txt)(.*)", "destination": "/aldric-dashboard/index.html" },
    { "source": "/((?!api/|aldric-dashboard/).*)", "destination": "/index.html" }
  ]
}
