modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
GOOGLE_SHEETS_ID = "1boeUUyhKIKHxCtKCLQsyw1DqNJw5DhnNQeA77fbWAPI"
WHATSAPP_LINK = ""
WHATSAPP_NUMBER = ""
