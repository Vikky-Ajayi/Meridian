modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/aldric-dashboard: web"

[[workflows.workflow]]
name = "artifacts/aldric-dashboard: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=23038 BASE_PATH=/aldric-dashboard/ pnpm --filter @workspace/aldric-dashboard run dev"
waitForPort = 23038

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
GOOGLE_SHEETS_ID = "1boeUUyhKIKHxCtKCLQsyw1DqNJw5DhnNQeA77fbWAPI"
WHATSAPP_LINK = ""
WHATSAPP_NUMBER = ""
